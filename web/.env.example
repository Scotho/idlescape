# Local-dev template (copy to web/.env.local). The Auth/Firestore emulators do not validate
# apiKey, so any non-empty string works here. The REAL web app config for production builds is
# the tracked web/.env.production (Firebase web app "idlescape-web").
VITE_FIREBASE_API_KEY=placeholder-api-key
VITE_FIREBASE_AUTH_DOMAIN=idlescape-osrs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=idlescape-osrs
VITE_FIREBASE_APP_ID=placeholder-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=placeholder-sender-id
VITE_USE_FIREBASE_EMULATORS=true
