# web/.env.e2e -- the browser config for a Playwright run against the local Firebase emulators,
# loaded by `npm run build:e2e` (vite build --mode e2e). Tracked on purpose: web/.env.local is
# gitignored, and `.env.production` (the real Firebase web app) would otherwise be what a
# production-mode build handed the e2e stack, pointing the shell at real Firebase while the
# front server verifies tokens against the emulator.
# Vite loads .env, .env.e2e and .env.e2e.local in mode e2e -- .env.[mode] beats .env.local, and
# .env.production is not read at all outside mode production. The emulators do not validate
# apiKey/appId, so the placeholders below are enough.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=placeholder-api-key
VITE_FIREBASE_AUTH_DOMAIN=idlescape-osrs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=idlescape-osrs
VITE_FIREBASE_APP_ID=placeholder-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=placeholder-sender-id
