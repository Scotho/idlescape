# web/.env.production -- the Firebase web app config a production `vite build` reads, and that
# deploy/lightsail/release.ps1 reads for the server image's build args.
#
# This is the public template. Create your own Firebase project, register a web app, and paste
# its config here (`firebase apps:sdkconfig WEB <app id> --project <project id>`). These are
# public client-side identifiers, not secrets, which is why this file is tracked. Local play and
# Playwright never read it: they use web/.env.e2e and the emulators.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=idlescape-osrs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=idlescape-osrs
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
