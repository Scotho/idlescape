# deploy/docker/.env.example -- template for deploy/docker/.env, read by `docker compose` for
# variable interpolation in docker-compose.yml (build args, the tunnel token, PUBLIC_ORIGIN).
# deploy/lightsail/release.ps1 generates the real file on the box as
# /opt/idlescape/secrets/compose.env; this example documents the keys for a manual run. This is separate from server/.env (which the front server
# reads at runtime for OWNER_ASSERTION_SECRET/ENGINE_MANAGEMENT_SECRET/FIREBASE_PROJECT_ID) -- the
# VM needs both files;
# see README.md.

# --- scripts/upstream.lock pins ---------------------------------------------------------------
# The two "engine/server" / "engine/content" hex shas from scripts/upstream.lock at the released commit.
ENGINE_SHA=
CONTENT_SHA=

# --- web/.env.example's five VITE_FIREBASE_* values (public web SDK config, not secret) -------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=idlescape-osrs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=idlescape-osrs
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- public origin --------------------------------------------------------------------------
# Used both as the front server's PUBLIC_ORIGIN and (via docker-compose.yml's build args) as the
# 274 engine's web.allowedOrigin -- must be exactly this, protocol + host, no trailing slash.
PUBLIC_ORIGIN=https://osrs.scotho.com

# --- absolute paths to runtime secrets (never inside the source tree) ---------------------------
# On the Lightsail box these live in /opt/idlescape/secrets (written by
# deploy/lightsail/provision.ps1); the compose file falls back to the repo-relative dev paths
# for the first two when unset, but TUNNEL_CREDENTIALS_FILE is required to start `cloudflared`
# (profile "public"). SERVER_ENV_FILE is env_file'd into BOTH the server and the engine service:
# OWNER_ASSERTION_SECRET and ENGINE_MANAGEMENT_SECRET are one value each shared by the two halves,
# so that file is their single source of truth and neither is ever a literal in this repo.
# The credentials JSON is the locally-managed one from %USERPROFILE%\.cloudflared\<tunnel id>.json;
# ingress lives in deploy/lightsail/cloudflared.yml.
SERVER_ENV_FILE=/opt/idlescape/secrets/server.env
FIREBASE_ADMIN_FILE=/opt/idlescape/secrets/firebase-admin.json
TUNNEL_CREDENTIALS_FILE=/opt/idlescape/secrets/tunnel-credentials.json
