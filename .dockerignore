# Build context excludes for deploy/docker/{engine,server}.Dockerfile. The compose file's
# build context is the repo root (`context: ../..`), so this file lives at the root, not under
# deploy/docker/. Mirrors .gitignore's shape but is independent of it: docker does not read
# .gitignore, and a couple of entries here (server/secrets/, server/.env) are excluded from the
# build context on purpose even though a real deployment needs them on disk -- they are mounted
# in at `docker compose up` time (secrets/env_file), never baked into an image layer.

# Pinned upstream clones (engine/server, engine/content) -- both Dockerfiles clone these
# themselves at the pinned sha via git, independent of whatever happens to be checked out on
# the build host. Excluding them here also keeps the Content clone's large binary/map/model
# assets out of the build context entirely.
engine/

# Dependencies and build output -- both Dockerfiles install and build from source.
**/node_modules/
client/out/
web/dist/
web/test-results/
web/playwright-report/

# Wiki generated output and its largest gitignored input. The wiki-build stage in
# server.Dockerfile clones Content at CONTENT_SHA and regenerates both, so shipping 250 MB to the
# daemon would be pure cost.
wiki/build/
wiki/data/*/loc-spawns.json

# Secrets and local env -- mounted/env_file'd at runtime, never sent to the docker daemon.
# server/.env.production.example used to be listed here and was deleted in the entry 2 work
# (audit C17, decision D96): the box's values are generated by deploy/lightsail/provision.ps1
# rather than copied from a template, so there is nothing left to exclude. server/.env.example
# is not excluded and never was: it carries no secrets, only key names, local dev defaults and
# comments.
server/secrets/
server/.env
web/.env.local
.env

# VCS, tooling, docs, logs -- irrelevant to the image, just bulk.
.git/
.github/
.claude/
.superpowers/
docs/
logs/
*.log
live/
client/.upstream-git/
