PORT=8787
# 8899 is the 274 dev engine (`npx tsx src/app.ts` in engine/server). 8888 is the live
# PoC instance -- never point a dev front server at it.
ENGINE_HTTP=http://127.0.0.1:8899
ENGINE_WS=ws://127.0.0.1:8899
# 8897 is the dev engine's management Fastify (Prometheus metrics, etc). It must
# never be exposed publicly -- only the front server should reach it.
ENGINE_MANAGEMENT_HTTP=http://127.0.0.1:8897
# Shared secret for the engine's owner-bank management routes and for the engine's
# /internal/bank-changed hook back into this server. The engine reads the SAME key
# (scripts/start-stack.ps1 exports it into the engine process). Empty locally means the
# bank routes stay unusable rather than unauthenticated. 32+ chars when set.
ENGINE_MANAGEMENT_SECRET=
# Shared with the engine overlay (scripts/start-stack.ps1 exports it into the engine process).
# 32+ chars. Empty disables owner binding: only valid against a dev world with
# node.production=false and login.requireOwner=false.
OWNER_ASSERTION_SECRET=
# The emulator project id, which must match firebase/.firebaserc's `default`.
FIREBASE_PROJECT_ID=idlescape-osrs
# Only read when FIREBASE_EMULATORS=false. A local emulator stack needs no such file, so a fresh
# clone can leave this pointing at a path that does not exist.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json
# Local development runs against the Firebase emulators. The deployed stack sets false in
# deploy/docker/docker-compose.yml regardless of what this file says.
FIREBASE_EMULATORS=true
# The origin THIS front server answers on. The deployed stack overrides it with the public one.
PUBLIC_ORIGIN=http://localhost:8787
WEB_DIST=../web/dist
# Local play and Playwright use the emulator-mode bundle so a production `npm run build`
# (real Firebase config) can never break sign-in against the emulators: set
# WEB_DIST=../web/dist-e2e locally and build it with `npm run build:e2e` in web/.
# scripts/verify.ps1 sets WEB_DIST=../web/dist-e2e itself for the stack it starts, so its
# Playwright step runs against the e2e bundle even on a checkout with no server/.env.
CLIENT_OUT=../client/out
ENGINE_PUBLIC=../engine/server/public
WIKI_DB=../wiki/build/wiki.db
