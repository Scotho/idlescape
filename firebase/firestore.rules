rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public profile. gameName is server-owned: clients may not set or change it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 1
                    && request.resource.data.displayName.size() <= 20
                    && !('gameName' in request.resource.data)
                    && !('characterIds' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gameName', 'createdAt', 'characterIds'])
                    && (!('displayName' in request.resource.data)
                        || (request.resource.data.displayName is string
                            && request.resource.data.displayName.size() >= 1
                            && request.resource.data.displayName.size() <= 20));
      allow delete: if false;

      // Per-user plugin settings (SP2a). Owner-only; typed top-level fields.
      match /plugins/{pluginId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.enabled is bool
                     && request.resource.data.settings is map;
      }

      // SP4b: per-script enable, per account rather than per character (spec decision 7).
      match /scriptToggles/{scriptId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.enabled is bool;
      }

      // SP4a: saved scripts. Owner-only; code is bounded; source is one of three values.
      match /tasks/{taskId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
                     && request.resource.data.code is string && request.resource.data.code.size() < 65536
                     && request.resource.data.source in ['user', 'fork', 'library'];
        // `write` above also covers delete, but a delete carries no `request.resource`, so
        // its shape checks raise a null-value error and deny. Deletes need their own rule.
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Server-only: game credentials and the name uniqueness index.
    match /gameAccounts/{uid} { allow read, write: if false; }
    match /gameNames/{name}   { allow read: if false; allow write: if false; }
    // Server-only: characters and audit logs.
    match /characters/{id} { allow read, write: if false; }
    match /audit/{id}      { allow read, write: if false; }

    // Pairing: readable by the owning uid so the browser can watch for state changes.
    // All writes are server-only (admin SDK via the pairing routes).
    match /pairTokens/{token} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /agentTokens/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
